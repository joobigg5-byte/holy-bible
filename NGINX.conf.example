# Nginx / VPS. Add inside your server block, then: nginx -t && systemctl reload nginx
server {
    root /var/www/holybible/dist;
    index index.html;

    # The line that fixes the 404s
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Never cache the entry point, or readers get stuck on an old build
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
    location = /sw.js {
        add_header Cache-Control "no-cache";
    }

    # Bible text and hashed assets are immutable
    location ~* \.(json|js|css|png|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
